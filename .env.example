# APP
NODE_ENV=development
API_PORT=3333
PORT=3333
CORS_ORIGIN=http://localhost:5173
WEB_PUBLIC_URL=http://localhost:5173
APP_PUBLIC_URL=http://localhost:3333
REDIS_URL=redis://localhost:6379
SETUP_TOKEN=

# DATABASE
DATABASE_URL=postgresql://operix:operix@localhost:5434/operix_mind?schema=public

# AUTH
JWT_SECRET=troque-este-valor-em-producao
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
AUTH_ACCESS_TTL=15m
AUTH_REFRESH_TTL=30d
SECRET_ENCRYPTION_KEY=

# ADMIN
ADMIN_BOOTSTRAP_EMAIL=admin@mind.local
ADMIN_BOOTSTRAP_PASSWORD=MindAdmin123!
ADMIN_BOOTSTRAP_NAME=Admin Mind_IA

# STORAGE
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=storage
MAX_UPLOAD_MB=25

# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_PROFILE=
AWS_S3_BUCKET=
AWS_S3_PUBLIC_BASE_URL=
AWS_SECRETS_MANAGER_PREFIX=
AWS_KMS_KEY_ID=
AWS_BEDROCK_MODEL_ID=
AWS_TEXTRACT_REGION=

# TELEGRAM
TELEGRAM_MAX_FILE_MB=25
TELEGRAM_STORAGE_DIR=storage/telegram
TELEGRAM_PAIRING_TTL_MINUTES=15
TELEGRAM_MAX_MESSAGES_PER_MINUTE=20
TELEGRAM_MAX_UPLOADS_PER_HOUR=30
TELEGRAM_MAX_DEEPCLAW_TASKS_PER_DAY=50

# BI
BI_ENABLED=true
BI_STORAGE_DIR=storage/bi
BI_MAX_UPLOAD_MB=50
BI_MAX_ROWS_PREVIEW=100
BI_MAX_ROWS_IN_MEMORY=50000
BI_ENABLE_AI_INSIGHTS=true
BI_ENABLE_INTERNAL_METRICS=true

# POWER BI FUTURE
POWERBI_TENANT_ID=
POWERBI_CLIENT_ID=
POWERBI_CLIENT_SECRET=
POWERBI_WORKSPACE_ID=

# EMAIL
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# OBSERVABILITY
LOG_LEVEL=info
ENABLE_PRETTY_LOGS=false
AUDIT_LOG_RETENTION_DAYS=90
MAX_JSON_BODY=2097152
UPLOAD_MAX_BYTES=26214400
MAX_REQUESTS_PER_MINUTE=120
MAX_AI_REQUESTS_PER_HOUR=60
MAX_AI_TOKENS_PER_HOUR=30000

# OAUTH
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_AZURE_CLIENT_ID=
OAUTH_AZURE_CLIENT_SECRET=

# LLM
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=gemma2:9b
